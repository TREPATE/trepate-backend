# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# Servidor HTTP
HOST=127.0.0.1
PORT=3000

# Supabase > Connect > ORMs > Prisma
# Conexión de la app, pasa por el pooler (puerto 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa para migraciones (puerto 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
